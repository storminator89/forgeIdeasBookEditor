# Database path (relative to packages/db directory)
DATABASE_URL="file:../../packages/db/dev.db"

# CORS Origin (optional, default: http://localhost:3001)
# CORS_ORIGIN="http://localhost:3001"

# Node environment (optional, default: development)
# NODE_ENV=development

# Encryption key for API keys (required in production, generate with: openssl rand -hex 32)
# ENCRYPTION_KEY="your-64-char-hex-key-here"
